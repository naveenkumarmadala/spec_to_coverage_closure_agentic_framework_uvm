# Simulation / build artifacts
*.vcd
*.fst
*.wlf
*.vvp
*.out
*.wdb
obj_dir/
sim_build/
work/
# Vivado xsim build/coverage scratch (left in dv/sv); durable copies live under ips/*/reports/
xsim.dir/
xsim.cov/
xsim.covdb/
xsim.codeCov/
*.jou
*.pb
.Xil/
*.log
!env/**/*.log
xsim*.log
# xcrg default report dirs when run outside run_regression.py
text_report/
codeCoverageReport/
functionalCoverageReport/
# waveforms from `xsim_flow.sh wave` (Vivado .wdb) and its generated tcl
**/reports/waves/
wave_run.tcl
# waveform-viewer layouts point at local, uncommitted .wdb files
*.wcfg
webtalk*.log
# static gate tool logs (regenerated by flow/scripts/static_gate.py; summary is reports/static_gate.txt)
**/dv/static_gate/
# regression run + coverage output (regenerated by flow/scripts/run_regression.py)
**/reports/_runs/
**/reports/_cov/
# one-page results view generated by run_regression.py (links into _cov/, so local only)
**/reports/coverage_dashboard.html

# Coverage
*.dat
*.ucdb
coverage/
*.info
*.gcda
*.gcno
annotated/

# PeakRDL / generated (regenerable — keep source RDL, ignore generated unless promoted)
**/generated/
*.pyc
__pycache__/
.pytest_cache/

# Python envs
.venv/
venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code local/personal config (per-developer, never shared)
.claude/settings.local.json

# Vivado xsim runtime journal files (process-specific, regenerated every run)
vivado_pid*.str

# Tool downloads
env/_tools/

# Personal / secret material — never commit
CLAUDE.local.md
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.wslconfig
