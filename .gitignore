**/reports/_runs/
**/reports/_cov/

# Coverage
*.dat
*.ucdb
coverage/
*.info
*.gcda
*.gcno
annotated/

# PeakRDL / generated (regenerable — keep source RDL, ignore generated unless promoted)
**/generated/
*.pyc
__pycache__/
.pytest_cache/

# Python envs
.venv/
venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code local/personal config (per-developer, never shared)
.claude/settings.local.json

# Vivado xsim runtime journal files (process-specific, regenerated every run)
vivado_pid*.str

# Tool downloads
env/_tools/

