# These files are consumed by the Linux toolchain in WSL2/Docker.
# Force LF so CRLF (from editing on Windows) never breaks bash / simulators / tools.
*.sh    text eol=lf
*.py    text eol=lf
*.sv    text eol=lf
*.svh   text eol=lf
*.v     text eol=lf
*.vh    text eol=lf
*.rdl   text eol=lf
*.f     text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
# xcrg coverage exclusion/waiver lists: a single CR makes xcrg ignore EVERY directive
# (silently un-scoping the coverage report), so these must never be checked out as CRLF.
*_exclusions.txt      text eol=lf
*_toggle_waivers.txt  text eol=lf
Makefile        text eol=lf
Dockerfile      text eol=lf
*.mk    text eol=lf

# Docs can follow platform conventions
*.md    text
